# Supabase PostgreSQL connection string (JDBC)
DB_URL=jdbc:postgresql://db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# JWT: use a random value with at least 32 characters
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_SECONDS=7200

# Supabase Storage
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_KEY=your-server-side-service-role-key
SUPABASE_BUCKET=products
